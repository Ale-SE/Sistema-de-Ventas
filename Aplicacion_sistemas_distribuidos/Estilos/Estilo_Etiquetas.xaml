<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--//////////////////////////////////////////////////////////////////////////-->
    <!--Estilos para textbox Normal-->
    <!--//////////////////////////////////////////////////////////////////////////-->

    <ImageBrush x:Key="Icon" ImageSource="/Imagenes/Principal_img/usuario.png"/>

    <Style x:Key="TextBoxNormal" TargetType="{x:Type TextBox}">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="DemiBold" />
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Width" Value="300"/>
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="Teal" />
        <Setter Property="Padding" Value="0 0 0 0" />
        <Setter Property="Margin" Value="10,15,0,0"/>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="TxtBorderEdit"
                        BorderBrush="Teal"
                        BorderThickness="0,0,0,2"
                        CornerRadius="3"
                        SnapsToDevicePixels="True">

                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ScrollViewer x:Name="PART_ContentHost"
                                      Focusable="False"
                                      Grid.Column="1"
                                      Margin="5 0 0 0"
                                      HorizontalScrollBarVisibility="Hidden"
                                      VerticalScrollBarVisibility="Hidden"/>

                            <Border Background="{StaticResource Icon}"
                                BorderThickness="0"
                                Height="15"
                                Width="15"
                                Margin="3 3 0 3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ToolTip="Tutora"
                                Cursor="Arrow"
                                Grid.Column="0"/>

                            <Label x:Name="WatermarkEdit"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"
                               Foreground="SlateGray"
                               Visibility="Collapsed"
                               Padding="30 0 0 0"
                               FontStyle="Italic"
                               FontWeight="DemiBold"                                  
                               Content="{TemplateBinding Tag}"
                               Grid.Column="1"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#FCA618" TargetName="TxtBorderEdit"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="teal" TargetName="TxtBorderEdit"/>
                            <Setter Property="BorderThickness" Value="0 0 0 3" TargetName="TxtBorderEdit"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Text" Value=""/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" TargetName="WatermarkEdit"/>
                        </MultiTrigger>
                        <!--<Trigger Property="IsFocused" Value="True">
                        <Setter Property="Visibility" Value="Hidden" TargetName="WatermarkEdit"/>
                    </Trigger>-->
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="Estilo_Labels_Elementos" TargetType="Label">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#2F4F4F"/>
        <Setter Property="FontStyle" Value="Normal"/>
        <Setter Property="FontWeight" Value="DemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,0"/>
    </Style>

    <Style x:Key="Estilo_Labels_Titulos" TargetType="Label">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="Teal"/>
        <Setter Property="FontStyle" Value="Italic"/>
        <Setter Property="FontWeight" Value="DemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,0"/>
    </Style>

</ResourceDictionary>