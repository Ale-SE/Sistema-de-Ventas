<Window x:Class="Aplicacion_sistemas_distribuidos.IniciodeSesion.Inicio_Sesion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Aplicacion_sistemas_distribuidos.InicioSesion"
        mc:Ignorable="d"
        Title="Inicio_Sesion" 
        Height="300" 
        Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize" >

    <!-- MODIFICA EL COLOR DEL BORDE -->
    <Border CornerRadius="5"
        BorderThickness="4">

        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0066cc" Offset="0"/>
                <GradientStop Color="Red" Offset="0.75"/>
                <GradientStop Color="Teal" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <!--  MODIFICA EL COLOR DEL FONDO DE LA VENTANA -->
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#F5F5F5" Offset="0"/>
            </LinearGradientBrush>
        </Border.Background>

        <!-- GRID PRINCIPAL CONTENEDOR -->
        <Grid x:Name="Grid_Central">
            <!-- EL STACKPANEL ES LA SECCION QUE CREAMOS EN ALGUN LUGAR DE LA VENTANA-->
            <StackPanel x:Name="StackPanel_Logo"
                        Width="200"
                        HorizontalAlignment="Left"
                        Orientation="Vertical"
                        Margin="0,0,0,0">
                <!-- EL LABEL ES LA ETIQUETA -->
                <Label x:Name="Label_Titulo_Logo"
                       Content="Sistemas Distribuidos"
                       Style="{StaticResource Estilo_Labels_Elementos}"/>

                <!-- AGREGAMOS Y MODIFICAMOS LA IMAGEN-->
                <Image Source="/Imagenes/Inicio_Img/usuario.png"
                       Width="120"
                       Height="120"
                       VerticalAlignment="Center"
                       Margin="0,10,0,0"
                       Stretch="Fill"/>



            </StackPanel>

            <StackPanel x:Name="StackPanel_Elementos"
                        Width="250"
                        HorizontalAlignment="Right"
                        Orientation="Vertical"
                        Margin="0,0,0,0">
                <Label x:Name="Label_Titulo_Inicio" 
                        Content="INICIAR SESIÓN"
                        Style="{StaticResource Estilo_Labels_Titulos}"/>

                <Label x:Name="Label_Usuario"
                       Content="Usuario"
                       Margin="0,15,0,0"
                       Style="{StaticResource Estilo_Labels_Elementos}"/>
                <ComboBox x:Name="Cbo_Usuarios"
                          Width="180"
                          IsEditable="True"
                          Text="Selecciona Usuario"
                          Foreground="#0066cc"
                          IsReadOnly="True">
                    <ComboBoxItem Content="Alex Vega"/>
                    <ComboBoxItem Content="Ale Serrano"/>
                    <ComboBoxItem Content="Alondra Ortiz"/>
                    <ComboBoxItem Content="Dorian Garcia"/>

                </ComboBox>

                <Label x:Name="Label_Clave"
                       Content="Clave"
                       Margin="0,0,0,0"
                       Style="{StaticResource Estilo_Labels_Elementos}"/>

                <PasswordBox x:Name="Txt_Password"
                             Width="180"
                             Height="20"
                             HorizontalAlignment="Center"
                             HorizontalContentAlignment="Center"
                             Margin="0,0,0,0">
                </PasswordBox>

                <Button x:Name="Btn_Iniciar"
                        Width="100"
                        Height="25"
                        Content="Iniciar"
                        Foreground="#0066cc"
                        Background="Transparent"
                        BorderBrush="#0066cc"
                        BorderThickness="2" 
                        Margin="10,20,0,0" 
                        Click="Btn_Iniciar_Click">

                </Button>

            </StackPanel>
        </Grid>
    </Border>
</Window>

</Window>
